+static void asf_close(void) {}
+static void asf_teardown(void) {}
+static int asf_sleep(struct device *dev) { return 0; }
+static int asf_wake(struct device *dev) { return 0; }
+
+static const struct i2c_algorithm *asf_ops(unsigned short base)
+{
+	return NULL;
+}
