# Maintainer: kotwicha <72318911+meetox80@users.noreply.github.com>
pkgname=amd-intertouch-dkms
_name=amd-intertouch
pkgver=0.1.1
pkgrel=1
pkgdesc="Synaptics InterTouch (RMI4 over SMBus) on AMD ThinkPads: patched i2c-piix4, rmi_smbus and psmouse via DKMS, with the amd-intertouch CLI"
arch=('x86_64')
url="https://github.com/meetox80/amd-intertouch"
license=('GPL-2.0-only')
depends=('dkms' 'gcc-libs' 'glibc')
makedepends=('cargo')
checkdepends=('patch')
provides=("$_name")
conflicts=('thinkpad-t14-amd-touchpad-dkms')
install=$pkgname.install
source=("$_name-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('f52eac5cff2c56f3a4da05e826da3690a75793a2ac14b0d55a0ed3406e68530b')

prepare() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_name-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$_name-$pkgver"
  install -Dm755 "target/release/$_name" "$pkgdir/usr/bin/$_name"
  install -d "$pkgdir/usr/src/$_name-$pkgver"
  cp -r dkms/. "$pkgdir/usr/src/$_name-$pkgver/"
  chmod 755 "$pkgdir/usr/src/$_name-$pkgver/tools/pre-build.sh"
  install -Dm644 packaging/amd-intertouch.conf "$pkgdir/usr/lib/modprobe.d/$_name.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
